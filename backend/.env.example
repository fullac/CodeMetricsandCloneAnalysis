PORT=3001
FINGERPRINT_DB_PATH=./data/fingerprints.sqlite
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your_sonar_global_or_project_token
SONAR_USER_TOKEN=replace_with_sonar_user_token
# local dev can be "sonar-scanner"; docker runtime uses "/opt/sonar-scanner/bin/sonar-scanner"
SONAR_SCANNER_BIN=sonar-scanner
# Scan the whole uploaded repository. SonarQube CE auto-detects languages by file suffix/plugin.
SONAR_SOURCES=.
# Optional allow-list, for example: **/*.ts,**/*.tsx,**/*.java
SONAR_INCLUSIONS=
# Default exclusions avoid dependencies/build artifacts while keeping multi-language source files.
SONAR_EXCLUSIONS=**/node_modules/**,**/.git/**,**/dist/**,**/build/**,**/coverage/**,**/.next/**,**/.nuxt/**,**/.venv/**,**/venv/**,**/target/**,**/vendor/**,**/*.min.js,**/*.map,**/*.lock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini
